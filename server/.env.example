# ─── Weblyrix Server — Environment Variables ───────────────────────────────
# Copy this to .env and fill in your actual keys

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# OpenAI — for Whisper STT + GPT chat
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ElevenLabs — for Text-to-Speech
# Get key at: https://elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Optional: specific ElevenLabs voice ID (default: Bella)
# Browse voices: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
